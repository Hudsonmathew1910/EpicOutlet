# Copy to .env and fill in. Never commit .env.

# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=127.0.0.1,localhost
# CSRF_TRUSTED_ORIGINS=https://shop.example.com

# Database (Supabase "Session pooler" URI). Leave empty to use local SQLite.
# URL-encode special characters in the password (@ -> %40).
DATABASE_URL=

# Cloudinary (product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI shop bot: HEROS is tried first (any OpenAI-compatible endpoint), then Groq,
# then a built-in catalogue search that needs no AI at all.
HEROS_API_KEY=
HEROS_BASE_URL=https://hero-s-ai.alwaysdata.net/api/v1
HEROS_MODEL=baymax-4.5
Groq_API_KEY_1=

# Razorpay (dashboard.razorpay.com -> Settings -> API Keys / Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# True: checkout pauses at the payment step and nothing is charged (demo store).
PAYMENT_DEMO_MODE=True

# Email (console backend prints emails to the terminal when unset)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
